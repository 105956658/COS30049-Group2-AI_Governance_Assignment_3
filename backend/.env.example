# Copy to backend/.env and adjust (optional: settings.py has the same defaults). backend/.env must be in .gitignore.
# There are no secrets in this app yet; if you add any (API keys etc.) they go here, never in code.

# Front-end origins allowed by CORS (comma separated). Never "*".
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Where the trained models are (defaults to backend/models)
# MODEL_DIR=
MODEL_VERSION=svc-gmm-rfr-1.0

# Input limits - keep in sync with frontend/src/config.js
MAX_CHARS=10000
MIN_WORDS=20

# Denial-of-service protection
DOS_PROTECTION=on          # "off" only for the before-measurement
INFERENCE_WORKERS=2
INFERENCE_QUEUE=4
INFERENCE_TIMEOUT=15
RATE_LIMIT_PER_MINUTE=30   # per client IP, 0 = off
